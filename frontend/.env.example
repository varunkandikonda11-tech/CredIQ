# Copy to .env to use the FastAPI backend (lender ML, /api/score, /api/assistant/chat).
# In dev, requests go through the Vite proxy — no CORS issues when the port is not 5173.
# Optional Ollama: ollama pull llama3.2 && ollama serve
VITE_API_URL=http://localhost:8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
